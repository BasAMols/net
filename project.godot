;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/updates_per_second=30

[application]

config/name="HexGrid"
run/main_scene="uid://7pxlpy0ownmu"
config/use_custom_user_dir=true
config/custom_user_dir_name="HexNet"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
run/low_processor_mode=true
boot_splash/bg_color=Color(0.22745098, 0.19607843, 0.27450982, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
